{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "yarn build",
  "installCommand": "yarn install --frozen-lockfile",
  "outputDirectory": ".next",
  "functions": {
    "pages/api/**/*.ts": { "memory": 1024, "maxDuration": 10 },
    "pages/api/**/*.js": { "memory": 1024, "maxDuration": 10 },
    "app/api/**/*.ts": { "memory": 1024, "maxDuration": 10 },
    "app/api/**/*.js": { "memory": 1024, "maxDuration": 10 }
  },
  "env": {
    "DATABASE_URL": "$DATABASE_URL"
  }
}
